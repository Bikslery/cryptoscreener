POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
RESET_JWT_SECRET=change_me
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# ── Monitoring (prometheus + grafana in compose) ──
# Static token for scraping /metrics. Prometheus REQUIRES it (compose fails
# without) — generate with: openssl rand -hex 24
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Exchange data ingestion (server) ──
# Binance WebSocket hosts. Defaults resolve centrally in
# server/src/services/exchanges/endpoints.ts — fstream.binance.com is
# geo-blocked in some regions; the default (fstream.binancefuture.com) is
# verified reachable everywhere the blocked host is not. Only override when
# diagnosing routing issues.
#BINANCE_FUTURES_WS_BASE=wss://fstream.binancefuture.com
#BINANCE_FUTURES_AGGTRADE_WS_BASE=wss://fstream.binancefuture.com
#BINANCE_SPOT_WS_BASE=wss://stream.binance.com:9443
# Min interval (ms) between emitted depth snapshots per symbol — raise to
# save CPU, lower for a fresher density map.
#DEPTH_EMIT_INTERVAL_MS=200
