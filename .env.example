POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
RESET_JWT_SECRET=change_me
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# ── Monitoring (prometheus + grafana in compose) ──
# Static token for scraping /metrics. Prometheus REQUIRES it (compose fails
# without) — generate with: openssl rand -hex 24
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
